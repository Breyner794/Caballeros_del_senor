# =============================================================================
#  Plantilla de variables para producción (Dokploy → pestaña Environment)
#
#  Este archivo NO se usa en el servidor: es la lista de lo que hay que pegar
#  en Dokploy. Los .env reales están en .gitignore y nunca se suben.
#
#  Reemplaza tudominio.com por el dominio real en los cuatro sitios marcados.
# =============================================================================

# ---------- Base de datos ----------
# La contraseña viaja dentro de una URL (postgresql://usuario:clave@host), así
# que NO uses `openssl rand -base64`: los caracteres + / = la rompen. Usa hex:
#   openssl rand -hex 24
POSTGRES_USER=cds
POSTGRES_PASSWORD=
POSTGRES_DB=caballeros

# ---------- Redis ----------
# Misma regla: hex, no base64.  openssl rand -hex 24
REDIS_PASSWORD=

# Nota: DATABASE_URL y REDIS_URL no se definen aquí. El compose las arma con
# los nombres de servicio internos (postgres:5432, redis:6379). Si las pones
# a mano apuntando a localhost o al dominio del VPS, la API no conectará.

# ---------- API ----------
API_PREFIX=api/v1

# ---------- Orígenes de CORS ----------
# Los dominios desde los que el navegador carga cada frontend. Con https (la
# cookie de refresh es `secure` en producción) y SIN barra final.
# La API debe quedar en un subdominio del MISMO dominio que el panel: la cookie
# usa sameSite=strict, que vale entre subdominios pero no entre dominios.
PANEL_ORIGIN=https://panel.tudominio.com
BOOKING_ORIGIN=https://tudominio.com

# ---------- Frontends (se consumen al COMPILAR, no en runtime) ----------
# Cambiarlas exige Rebuild en Dokploy: quedan incrustadas en el bundle.
VITE_API_URL=https://api.tudominio.com/api/v1

# ---------- Seguridad ----------
# Dos secretos DISTINTOS, mínimo 32 caracteres, y que no empiecen por
# "cambiame": la API valida las tres cosas y no arranca si fallan.
#   openssl rand -base64 48
JWT_ACCESS_SECRET=
JWT_ACCESS_TTL=15m
JWT_REFRESH_SECRET=
JWT_REFRESH_TTL=7d

# Exactamente 32 bytes en base64.  openssl rand -base64 32
ENCRYPTION_KEY=

# ---------- Zona horaria ----------
TZ=America/Bogota
BUSINESS_TIMEZONE=America/Bogota

# ---------- Brevo (correo transaccional) ----------
BREVO_API_KEY=
BREVO_SENDER_EMAIL=no-reply@tudominio.com
BREVO_SENDER_NAME=Caballeros del Senor

# ---------- WhatsApp Cloud API (Meta) ----------
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=

# ---------- Sembrado inicial de la base ----------
# Estas NO van en Dokploy: se pasan en la línea de comandos al sembrar, por el
# túnel SSH, porque el script usa tsx y no existe dentro del contenedor.
#
#   SEED_DEMO=false \
#   ADMIN_EMAIL=tu@correo.com \
#   ADMIN_PASSWORD="una larga y tuya" \
#   SEDE_NOMBRE="Caballeros del Señor" \
#   pnpm --filter @cds/api prisma:seed
#
# Sin SEED_DEMO=false se siembran además tres sedes de Bogotá, seis servicios
# con precios inventados y cinco usuarios de ejemplo, todo con la contraseña
# que está escrita en claro en prisma/seed.ts. Sirve para desarrollo; en
# producción no, sobre todo porque las sedes solo se pueden desactivar desde
# el panel, nunca borrar.

# ---------- Cloudflare Turnstile ----------
# Dashboard de Cloudflare → Turnstile → Add widget. Da dos claves:
#   Site Key   → VITE_TURNSTILE_SITE_KEY  (pública, va en el bundle de booking)
#   Secret Key → TURNSTILE_SECRET_KEY     (privada, solo la ve la API)
# En el widget, registra el hostname de BOOKING_ORIGIN.
VITE_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
