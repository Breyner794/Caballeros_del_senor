{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "rootDir": "src",
    // Sin compilacion incremental: nest-cli borra dist/ en cada build, pero el
    // .tsbuildinfo vive fuera y haria que tsc creyera que no hay nada que
    // emitir, dejando un dist/ incompleto.
    "incremental": false
  },
  "exclude": ["node_modules", "dist", "prisma", "**/*.spec.ts", "**/*.test.ts"]
}
