# ---------- Base de datos ----------
POSTGRES_USER=cds
POSTGRES_PASSWORD=cds_dev_password
POSTGRES_DB=caballeros
POSTGRES_PORT=5433
DATABASE_URL="postgresql://cds:cds_dev_password@localhost:5433/caballeros?schema=public"

# ---------- Redis ----------
REDIS_PASSWORD=cds_dev_redis
REDIS_PORT=6380
REDIS_URL="redis://:cds_dev_redis@localhost:6380"

# ---------- API ----------
NODE_ENV=development
API_PORT=3001
API_PREFIX=api/v1
PANEL_ORIGIN=http://localhost:5173
BOOKING_ORIGIN=http://localhost:5174

# ---------- Seguridad ----------
# Genera con: openssl rand -base64 48
JWT_ACCESS_SECRET=cambiame_access_secret_min_32_chars_dev
JWT_ACCESS_TTL=15m
JWT_REFRESH_SECRET=cambiame_refresh_secret_min_32_chars_dev
JWT_REFRESH_TTL=7d
# Clave de 32 bytes en base64 para cifrar credenciales de terceros en BD
ENCRYPTION_KEY=

# ---------- Zona horaria del negocio ----------
TZ=America/Bogota
BUSINESS_TIMEZONE=America/Bogota

# ---------- Brevo (correo transaccional) ----------
BREVO_API_KEY=
BREVO_SENDER_EMAIL=no-reply@caballerosdelsenor.com
BREVO_SENDER_NAME=Caballeros del Senor

# ---------- WhatsApp Cloud API (Meta) ----------
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
